/* osAfrica Plymouth boot splash script */

/* Background */
Window.SetBackgroundTopColor(0.05, 0.05, 0.10);
Window.SetBackgroundBottomColor(0.02, 0.02, 0.05);

/* Logo */
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 40);

/* Progress dots */
NUM_DOTS = 5;
dot_spacing = 20;
dots = [];

for (i = 0; i < NUM_DOTS; i++) {
    dots[i] = Sprite();
    dots[i].SetX(Window.GetWidth() / 2 - (NUM_DOTS * dot_spacing) / 2 + i * dot_spacing);
    dots[i].SetY(Window.GetHeight() / 2 + 60);
}

progress = 0;

fun refresh_callback() {
    progress++;
    active_dot = Math.Int(progress / 10) % NUM_DOTS;

    for (i = 0; i < NUM_DOTS; i++) {
        if (i == active_dot)
            dots[i].SetOpacity(1.0);
        else
            dots[i].SetOpacity(0.3);
    }
}

Plymouth.SetRefreshFunction(refresh_callback);

/* Hide password prompt details (show asterisks) */
fun display_password_callback(prompt, bullets) {
    /* Display bullets for password entry */
    for (i = 0; i < bullets; i++) {
        /* asterisk rendering handled by Plymouth */
    }
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);

/* Status messages */
message_sprite = Sprite();
message_sprite.SetPosition(Window.GetWidth() / 2, Window.GetHeight() / 2 + 100, 1);

fun message_callback(text) {
    /* Status text displayed below logo */
}

Plymouth.SetMessageFunction(message_callback);
